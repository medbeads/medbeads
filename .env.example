# MedBeads environment template.
# Copy this file to `.env` (next to docker-compose.yml) and fill in values.
# `.env` is gitignored and must never be committed.

# Shared secret used by internal services (the data-ingestion / clearance
# setup scripts) to assert the privileged `system` role, which bypasses all
# clearance rules. The Core server reads this as MEDBEADS_SERVICE_TOKEN.
#
# - Set it to a long random string for any non-local deployment.
# - If left empty, the `system` role can NEVER be asserted by a request
#   (browsers and external callers are always treated as their stated,
#   non-privileged roles, or as an unidentified viewer if no role is sent).
MEDBEADS_SERVICE_TOKEN=changeme-dev-token

# CORS allowlist: comma-separated browser origins allowed to call the API.
# A single "*" restores the previous allow-all behavior (not recommended).
MEDBEADS_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Per-IP request rate limit (requests per minute). Default 600.
MEDBEADS_RATE_LIMIT=600
